# ============================================================================
# 轨道 A 种子配置：OpenWrt 官方 main / qualcommax / ipq50xx / cmcc_rax3000q
#
# 只需要写「目标 + 想装的包」，其余交给 make defconfig 自动展开。
# 注意：这里显式编入的 kmod-* 会让产物 vermagic 与官方 snapshot 不同，
#      即「以后从官方源 apk add kmod-xxx」可能装不上（用户态包不受影响）。
#      PassWall 需要的 kmod-nft-tproxy / kmod-nft-socket 会被自动选中，属于必需。
# ============================================================================

# ------------------------------------------------------------------ 目标平台
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_cmcc_rax3000q=y

# ------------------------------------------------------------ 基础系统 / LuCI
CONFIG_PACKAGE_luci=y
# luci-ssl = LuCI + HTTPS，SSL 后端为 mbedtls
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-proto-dhcp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-static=y

# ------------------------------------------------------------- LuCI 中文界面
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y

# ------------------------------------------------- Kwrt 风格界面：Argon 主题
# 主题与配置插件由 scripts/diy-mainline-part2.sh 从 jerrykuku/luci-theme-argon 拉取，
# 默认主题由 files/etc/uci-defaults/99-kwrt-style 在首次启动时设置
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ------------------------------------------------------------------ DNS / DHCP
# PassWall 的 DNS 分流依赖完整的 dnsmasq（ipset/nftset 支持）
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# ============================================================ PassWall + Xray
# PassWall 属于 Lua 版 LuCI 应用（会带上 luci-compat / lua）
CONFIG_PACKAGE_luci-app-passwall=y

# 透明代理：新版 OpenWrt 是 firewall4 + nftables
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy is not set

# 核心：Xray（完整兼容 v2ray 协议：VMess / VLESS / Trojan / Shadowsocks，
# 也能直接导入 v2ray 订阅；上游 passwall 在 2026 年已不再维护 v2ray-core）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# 其它核心/插件（256MB 内存 + 58MB 镜像上限，按需再打开）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview is not set

CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# ---------------------------------------------------------------- 常用小工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
